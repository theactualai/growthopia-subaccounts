# ============================================================
# Paste these into Vercel: Project > Settings > Environment Variables
# Set each one for Production, Preview and Development.
# Nothing here belongs in git. .env is gitignored.
# ============================================================

# --- Spaceship: buys domains and sets nameservers ---
# spaceship.com/application/api-manager  ->  New API key
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# --- Cloudflare: email routing and catch-all, free ---
# dash.cloudflare.com/profile/api-tokens  ->  Create Token  ->  Custom token
# Needs: Account>Zone:Edit, Zone>DNS:Edit, Zone>Email Routing Rules:Edit, Zone>Zone Settings:Read
CLOUDFLARE_API_TOKEN=
# Account ID is on the right-hand sidebar of any domain's overview page
CLOUDFLARE_ACCOUNT_ID=
# The real inbox every catch-all address forwards to. Must be verified in Cloudflare first.
CLOUDFLARE_DESTINATION_EMAIL=

# --- Supabase: database, auth and the locked secrets table ---
# supabase.com/dashboard  ->  your project  ->  Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Bypasses row-level security. Server only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Anthropic: powers the handle finder on Vercel ---
# console.anthropic.com  ->  API keys
# Without this the handle finder silently falls back to rule-based ideas only.
ANTHROPIC_API_KEY=

# --- Encryption for 2FA secrets at rest, generated not copied ---
# Any 32-byte random string. Ask me and I'll generate one.
TOTP_ENCRYPTION_KEY=

# --- Existing vendors, when you're ready to wire them ---
GOLOGIN_API_TOKEN=
WEBSHARE_API_KEY=
TEXTVERIFIED_API_KEY=

# --- Local only: for scripts/proxy-check.mjs ---
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
